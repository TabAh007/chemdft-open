# Web → API server-only URL
CHEMDFT_API_URL=http://127.0.0.1:8000

# Local development identity. Never enable this in a shared or production environment.
CHEMDFT_DEV_IDENTITY_ENABLED=true
CHEMDFT_AUTO_CREATE_SCHEMA=true

# PostgreSQL is the application database target. SQLite remains available only
# for isolated local smoke tests and automated unit tests.
CHEMDFT_DATABASE_URL=postgresql+psycopg://chemdft:chemdft@127.0.0.1:5432/chemdft
CHEMDFT_OBJECT_ROOT=./.chemdft/objects

# --- Authentication (PF-1). Names only: never commit values. ---
# CHEMDFT_ENV=development             # development | local | test are the only values that allow the fixed dev identity
# CHEMDFT_AUTH_MODE=dev               # dev (local only: fixed development identity) | jwt (real sign-in)
# CHEMDFT_LAUNCH_STATE=prelaunch      # prelaunch (default) | public — open signup is refused while prelaunch
# CHEMDFT_SIGNUP_MODE=closed          # closed (default) | invite (behaves as closed until invites exist) | open (needs public + an email provider)
# --- jwt mode, web (Next.js server; never NEXT_PUBLIC_*) ---
# BETTER_AUTH_SECRET=                 # random, >= 32 characters
# BETTER_AUTH_URL=http://127.0.0.1:3000
# CHEMDFT_AUTH_DATABASE_URL=file:./.chemdft/auth.db   # local default; hosted REQUIRES an explicit postgres:// URL
# GOOGLE_CLIENT_ID=                   # optional; Google is hidden unless both are set
# GOOGLE_CLIENT_SECRET=
# CHEMDFT_EMAIL_PROVIDER=none         # none | dev (local sink); no production provider yet
# --- jwt mode, API ---
# CHEMDFT_AUTH_ISSUER=http://127.0.0.1:3000          # = BETTER_AUTH_URL origin
# CHEMDFT_AUTH_AUDIENCE=chemdft-api
# CHEMDFT_AUTH_JWKS_URL=http://127.0.0.1:3000/api/auth/jwks


# --- Experimental AWS compute (OFF by default; LOCAL stays the default provider). Names only. ---
# Needs an owner-approved session: tools/aws_session.py open (never started by the application).
# CHEMDFT_COMPUTE_AWS_ENABLED=false
# CHEMDFT_AWS_CONFIG_FILE=            # dedicated chemdft-pilot login config (no static keys)
# CHEMDFT_AWS_PILOT_BUCKET=           # chemdft-ec2-pilot-artifacts-...
# CHEMDFT_AWS_INSTANCE_ID=            # the existing pilot instance
# CHEMDFT_AWS_IMAGE_ID=               # sha256:... of the image already built on the host
# CHEMDFT_AWS_SESSION_FILE=./.chemdft/aws-session.json
# CHEMDFT_COMPUTE_DEFAULT_PROVIDER=local   # "aws" makes AUTO use AWS only while a session is open
